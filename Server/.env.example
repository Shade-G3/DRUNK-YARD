# Set these in Render → Environment (the server reads process.env; it does not load .env files).
# Locally, no variables are needed — the defaults work. Never commit real secrets.
NODE_ENV=production
PORT=3000

# Your public site URL(s), comma-separated. Same-origin deploys work without it.
ALLOWED_ORIGINS=https://drunk-yard.onrender.com

# Render / Railway / Fly = 1. Cloudflare in front of Render = 2. Local dev = 0.
TRUST_PROXY_HOPS=1

# TURN (strongly recommended for production — ~15–20% of Indian mobile users need it).
# coturn with: use-auth-secret + static-auth-secret=<same as TURN_SECRET>
TURN_URLS=turn:turn.yourdomain.com:3478,turns:turn.yourdomain.com:5349
TURN_SECRET=change-me-long-random-string
TURN_TTL_SEC=3600

# Safety
REPORTS_TO_BAN=3
BAN_HOURS=24
MAX_CONN_PER_IP_PER_MIN=30
